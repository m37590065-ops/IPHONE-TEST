# ============================================================
# إعدادات الموقع — مجموعة الهواتف
# لا تضع أي مفاتيح سرية هنا: هذا موقع ثابت والملف قد يُنشر للعميل.
# ============================================================

# --- الخادم المحلي (server.py) ---
HOST=127.0.0.1
PORT=8000

# --- ربط نموذج الطلب ---
# رابط Google Apps Script Web App المنشور (ينتهي بـ /exec)
# اتركه فارغًا لتعطيل إرسال الطلبات
ORDER_ENDPOINT=

# --- إعدادات الواجهة ---
# إظهار قسم «لماذا تختارنا»
SHOW_TRUST_SECTION=true

# --- التوصيل والأسعار ---
# اترك الأسعار فارغة لعدم إظهارها (لا تُخترع قيم)
DELIVERY_ENABLED=true
UNIT_PRICE=
DELIVERY_COST=
CURRENCY=

# --- بيانات إضافية ---
SITE_NAME=مجموعة الهواتف
SITE_LANG=ar
SITE_DIR=rtl
